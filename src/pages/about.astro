---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About">
  <h1>About</h1>
  <p class="text-lg text-slate-600 dark:text-slate-400 mb-6">
    I am an Oracle Fusion Finance Functional Consultant. I work on implementations,
    configurations, and troubleshooting across the Finance modules.
  </p>
  <p>
    This blog is my way of leaving markers on the trail — sharing what I learn so that
    the next consultant navigating these systems has a slightly easier path.
  </p>
  <p class="mt-8">
    <a href="https://www.linkedin.com/in/YOUR_USERNAME" class="inline-flex items-center gap-2 bg-slate-900 text-white px-5 py-2.5 rounded-md font-medium hover:bg-slate-700 transition dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-300">
      Connect on LinkedIn →
    </a>
  </p>
</BaseLayout>
