---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const latestPosts = allPosts
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5);
---

<BaseLayout title="Home" description="Oracle Fusion Finance Functional Consultant sharing configurations, troubleshooting, and concepts.">
  <section class="mb-16">
    <h1>Leaving markers in the enterprise ERP wilderness.</h1>
    <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl">
      Welcome to <strong>Cairn</strong>. I am an Oracle Fusion Finance Functional Consultant.
      This site is a collection of configurations, troubleshooting steps, and observations
      from my implementations. My goal is to leave a clear path for the next consultant navigating the same complex systems.
    </p>
    <div class="mt-6">
      <a href={`${import.meta.env.BASE_URL}posts/`} class="inline-block bg-slate-900 text-white px-6 py-3 rounded-md font-medium hover:bg-slate-700 transition dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-300">
        Read the Archive →
      </a>
    </div>
  </section>

  <section>
    <h2 class="text-2xl font-serif font-bold mb-6">Recent Markers</h2>
    {latestPosts.length === 0 ? (
      <p class="text-slate-500 dark:text-slate-400 italic">Your first post will appear here soon.</p>
    ) : (
      <ul class="space-y-6">
        {latestPosts.map(post => (
          <li>
            <a href={`${import.meta.env.BASE_URL}posts/${post.id}/`} class="group block">
              <h3 class="text-xl font-semibold group-hover:text-slate-600 dark:group-hover:text-slate-300 transition">
                {post.data.title}
              </h3>
              <time class="text-sm text-slate-500 dark:text-slate-400">
                {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              {post.data.description && (
                <p class="mt-2 text-slate-600 dark:text-slate-400">{post.data.description}</p>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
