---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Leaving markers in the enterprise ERP wilderness." } = Astro.props;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#F9F8F6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Premium Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    
    <title>{title} | Cairn</title>
  </head>
  <body>
    <header class="container header">
      <a href="/" class="logo">Cairn</a>
      <nav class="nav-links">
        <a href="/posts/">Archive</a>
        <a href="/about/">About</a>
      </nav>
    </header>

    <main class="container main-content">
      <slot />
    </main>

    <footer class="container footer">
      <p>&copy; {currentYear} Cairn. Built with intention.</p>
    </footer>
  </body>
</html>
